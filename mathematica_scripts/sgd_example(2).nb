Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gb", " ", "=", " ", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"u", "[", "x", "]"}]}], "/", "T"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"langevin", ":", " ", "dx"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "mu"}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], ",", "x"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", "a"}], "]"}], " ", "dW"}]}]}], ";", "  ", 
    RowBox[{"FP", " ", "stazionaria", " ", 
     RowBox[{"associata", " ", ":"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"fpeq", " ", "=", " ", 
  RowBox[{"0", "\[Equal]", 
   RowBox[{
    RowBox[{"a", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"p", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", " ", 
    RowBox[{"mu", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", "x", "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], ",", "x"}], "]"}]}], ",", "x"}], 
      "]"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"fpeq", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "x", "]"}], "\[Rule]", "gb"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "'"}], "[", "x", "]"}], "\[Rule]", 
       RowBox[{"D", "[", 
        RowBox[{"gb", ",", "x"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "''"}], "[", "x", "]"}], "\[Rule]", 
       RowBox[{"D", "[", 
        RowBox[{"gb", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "nota", " ", "come", " ", "si", " ", "pu\[OGrave]", " ", "raccogliere", 
    " ", "il", " ", "fattore", " ", 
    RowBox[{"(", 
     RowBox[{"a", "-", 
      RowBox[{"mu", " ", "T"}]}], ")"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"fpeq", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "x", "]"}], "\[Rule]", "gb"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "'"}], "[", "x", "]"}], "\[Rule]", 
       RowBox[{"D", "[", 
        RowBox[{"gb", ",", "x"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "''"}], "[", "x", "]"}], "\[Rule]", 
       RowBox[{"D", "[", 
        RowBox[{"gb", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], ",", "a"}], 
  "]"}]}], "Input",
