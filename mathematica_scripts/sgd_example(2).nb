 RowBox[{
  RowBox[{"T", "=", " ", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Pstat", "[", 
     RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"U", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "/", "T"}], "]"}], "*", 
      RowBox[{"loss", "[", 
