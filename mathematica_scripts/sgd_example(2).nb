Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"loss", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "]"}], "/.", 
