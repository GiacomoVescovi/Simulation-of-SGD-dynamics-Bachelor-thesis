Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", "setup", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ftrue", "[", "x_", "]"}], ":=", 
     RowBox[{"1", "+", 
      RowBox[{"x", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"5", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"-", "x"}], ")"}]}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}]}]}]}], ")"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "modello", " ", "\"\<vero\>\"", " ", "dal", " ", "quale", " ", "si", " ", 
     "generano", " ", "i", " ", "dati"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"atrue", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"In", " ", "realt\[AGrave]", " ", "qualunque", " ", "a"}], " ",
        ">", " ", 
       RowBox[{
       "0", " ", "si", " ", "comporta", " ", "nello", " ", "stesso", " ", 
        "modo"}]}], ";", " ", 
      RowBox[{"questo", " ", "\[EGrave]", " ", "un", " ", 
       RowBox[{"po", "'"}], " ", "il", " ", "\"\<problema\>\"", " ", "di", 
       " ", "questa", " ", "funzione", " ", "obiettivo"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "ma", " ", "anche", " ", "la", " ", "feature", " ", "che", " ", "crea", 
       " ", "dei", " ", "minimi", " ", "con", " ", "una", " ", "grande", " ", 
       "differenza", " ", "di", " ", "curvature", " ", "lungo", " ", "b"}], 
      ";", " ", 
      RowBox[{
      "ovviamente", " ", "\[EGrave]", " ", "stata", " ", "scelta", " ", "in", 
       " ", "maniera", " ", "artificiale", " ", "perch\[EAcute]", " ", 
       "avesse", " ", "sia", " ", "minimi", " ", "molto", " ", "piccati", " ",
        "che", " ", "minimi", " ", "molto", " ", "piatti"}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"btrue", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fmod", "[", 
      RowBox[{"x_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"x", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"b", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "a"}], " ", "x"}], ")"}]}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}]}]}]}], ")"}]}], "+", 
      RowBox[{"a", "^", "2"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"NOTA", ":", " ", 
     RowBox[{
      RowBox[{
      "puoi", " ", "provare", " ", "ad", " ", "aggiungere", " ", "questo", 
       " ", "termine", " ", 
       RowBox[{"a", "^", "2"}], " ", "come", " ", "\"\<penalit\[AGrave]\>\"", 
       " ", "per", " ", "eliminare", " ", "gli", " ", "infiniti", " ", 
       "minimi", " ", "con", " ", "a"}], ">", "0"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", " ", "-", 
        RowBox[{"fmod", "[", 
         RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}]}], 
    ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "questa", " ", "\[EGrave]", " ", "solo", " ", "la", " ", "parte", " ", 
      "quadratica"}], ",", " ", 
     RowBox[{"senza", " ", "somma", " ", "o", " ", "normalizzazione"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradloss", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", " ", "-", 
            RowBox[{"fmod", "[", 
             RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}], 
         ",", "a"}], "]"}], ",", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", " ", "-", 
            RowBox[{"fmod", "[", 
             RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}], 
         ",", "b"}], "]"}]}], "}"}]}], " ", ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"ftrue", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
