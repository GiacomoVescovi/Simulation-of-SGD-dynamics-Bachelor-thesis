Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxite2", "=", "1002"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eta", " ", "=", " ", "0.0001"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vgd", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "maxite2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"vgd", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"a0", ",", "b0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"ite", "=", "2"}], ",", 
     RowBox[{"ite", "<=", "maxite2"}], ",", " ", 
     RowBox[{"ite", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ai", " ", "=", " ", 
       RowBox[{
        RowBox[{"vgd", "[", 
         RowBox[{"[", 
          RowBox[{"ite", "-", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bi", "=", " ", 
       RowBox[{
        RowBox[{"vgd", "[", 
         RowBox[{"[", 
          RowBox[{"ite", "-", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"calcola", " ", 
        RowBox[{"l", "'"}], "incremento"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dai", " ", "=", 
       RowBox[{
        RowBox[{"eta", " ", 
         RowBox[{
          RowBox[{"gradlosstot", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "\[Rule]", "ai"}], ",", 
          RowBox[{"y", "\[Rule]", "bi"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dbi", " ", "=", 
       RowBox[{
        RowBox[{"eta", " ", 
         RowBox[{
          RowBox[{"gradlosstot", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "\[Rule]", "ai"}], ",", 
          RowBox[{"y", "\[Rule]", "bi"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vgd", "[", 
        RowBox[{"[", "ite", "]"}], "]"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ai", "-", "dai"}], ",", " ", 
         RowBox[{"bi", "-", "dbi"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"ite", ",", "100"}], "]"}], "\[Equal]", "0"}], ",", " ", 
        RowBox[{"Print", "[", 
         RowBox[{"ite", ",", " ", "\"\<, \>\"", ",", " ", 
          RowBox[{"vgd", "[", 
           RowBox[{"[", "ite", "]"}], "]"}]}], "]"}]}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]}]], "Input",
