Cell[CellGroupData[{

Cell[TextData[StyleBox["Cerco il minimo negativo per verificare il crossing",
 FontColor->RGBColor[1, 0.5, 0]]], "Chapter",
 CellChangeTimes->{{3.9191575552129097`*^9, 3.9191575625327487`*^9}, {
  3.919157700221616*^9, 
  3.9191577154090233`*^9}},ExpressionUUID->"5a6b3b82-5fd6-4df2-99ae-\
3180fa971c9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Trovo", " ", "ilm", " ", "minimo", " ", "negativo", " ", "della", " ", 
    "funzione"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"arealmin", "=", 
     RowBox[{"x", "/.", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"loss", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", 
           RowBox[{"x", "<", "0"}]}], " ", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brealmin", "=", 
     RowBox[{"y", "/.", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"loss", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", 
           RowBox[{"x", "<", "0"}]}], " ", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"a", ",", "brealmin"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", 
       RowBox[{"-", "l"}], ",", "l"}], "}"}], ",", " ", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<a\>\"", ",", "\"\<loss\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"arealmin", ",", "b"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", 
       RowBox[{"-", "l"}], ",", "l"}], "}"}], ",", " ", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<b\>\"", ",", "\"\<loss\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<arealmin, brealmin: \>\"", ",", " ", "arealmin", ",", "\"\< \>\"", 
     ",", "brealmin"}], "]"}]}]}]], "Input",
