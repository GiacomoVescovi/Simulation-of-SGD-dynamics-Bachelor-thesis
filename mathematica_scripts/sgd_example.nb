Cell[CellGroupData[{

Cell[TextData[StyleBox["Training tramite SGD",
 FontColor->RGBColor[1, 0.5, 0]]], "Subtitle",
 CellChangeTimes->{{3.9191381780620575`*^9, 
  3.9191381841755047`*^9}},ExpressionUUID->"e6f89b8e-7071-421a-bb8c-\
8b3e92fbdec8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"IPERPARAMETRI", " ", "DEL", " ", "SGD"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxite", " ", "=", "60000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eta", " ", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bsize", " ", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "costruisco", " ", "il", " ", "vettore", " ", "dei", " ", "parametri", 
      " ", "che", " ", "ottimizzo"}], ",", " ", 
     RowBox[{
     "tengo", " ", "tutti", " ", "le", " ", "iterazioni", " ", "per", " ", 
      "la", " ", "visualizzazione"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "maxite"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossvalues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "maxite"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{"per", " ", "visualizzazione"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totlossvalues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "maxite"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "sarebbe", " ", "la", " ", "loss", " ", "usata", " ", "nel", " ", "GD"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"a0", ",", "b0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"SGD", " ", "loop"}], " ", "**"}], "**"}], "**"}],
                     "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], 
                    "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], 
              "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], "**"}], 
      "**"}], "**"}], "********)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"nota", ":", " ", 
      RowBox[{
      "faccio", " ", "il", " ", "caso", " ", "semplice", " ", "del", " ", 
       "ciclo", " ", "for"}]}], ",", " ", 
     RowBox[{
     "si", " ", "pu\[OGrave]", " ", "sostituire", " ", "con", " ", "un", " ", 
      "while", " ", "per", " ", "controllare", " ", "se", " ", "sta", " ", 
      "raggiungendo", " ", "la", " ", "convergenza"}]}], " ", "*)"}], "\n", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"ite", "=", "2"}], ",", 
     RowBox[{"ite", "<=", "maxite"}], ",", " ", 
     RowBox[{"ite", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"ite", ",", "10000"}], "]"}], "\[Equal]", "0"}], ",", " ", 
        RowBox[{"Print", "[", 
