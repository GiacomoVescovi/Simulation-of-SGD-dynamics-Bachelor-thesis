Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "calcolo", " ", "la", " ", "loss", " ", "function", " ", "su", " ", 
     "tutto", " ", "il", " ", "set", " ", "di", " ", "dati"}], ",", " ", 
    RowBox[{"in", " ", "funzione", " ", "dei", " ", "parametri"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "ntot"}], ")"}], "*", " ", 
      RowBox[{"Sum", "[", " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], "-", 
             RowBox[{"fmod", "[", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "a", ",", "b"}], 
              "]"}]}], ")"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "ll"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Trovo", " ", "ilm", " ", "minimo", " ", "reale", " ", "della", " ", 
     "funzione"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"areal", "=", 
     RowBox[{"x", "/.", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"loss", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "<", "1.5"}], " ", "&&", 
            RowBox[{
             RowBox[{"Abs", "[", "y", "]"}], "<", "1"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"breal", "=", 
     RowBox[{"y", "/.", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"loss", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "<", "1.5"}], " ", "&&", 
            RowBox[{
             RowBox[{"Abs", "[", "y", "]"}], "<", "1"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", 
       RowBox[{"-", "l"}], ",", "l"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", 
       RowBox[{"-", "l"}], ",", "l"}], "}"}], ",", " ", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<a\>\"", ",", "\"\<b\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"loss", "[", 
      RowBox[{"a", ",", "breal"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", 
