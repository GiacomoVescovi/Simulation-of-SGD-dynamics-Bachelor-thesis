Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "questo", " ", "codice", " ", "analizza", " ", "le", " ", 
     "propriet\[AGrave]", " ", "statistiche", " ", "di", " ", "realizzazioni",
      " ", "con", " ", "lo", " ", "stesso", " ", "starting", " ", "point"}], 
    ",", " ", 
    RowBox[{
    "ma", " ", "sotto", " ", "ho", " ", "un", " ", "codice", " ", "che", " ", 
     "simula", " ", "cammini", " ", "con", " ", "diversi", " ", "starting", 
