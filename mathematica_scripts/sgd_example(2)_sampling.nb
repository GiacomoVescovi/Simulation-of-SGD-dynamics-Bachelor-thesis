Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Trovo", " ", "il", " ", "minimo", " ", "negativo", " ", "della", " ", 
    "funzione"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"arealmin", "=", 
     RowBox[{"x", "/.", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"loss", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", 
           RowBox[{"x", "<", "0"}]}], " ", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"brealmin", "=", 
     RowBox[{"y", "/.", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"loss", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", 
           RowBox[{"x", "<", "0"}]}], " ", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}]}]}], 
    ";"}]}]}]], "Input",
