Cell[BoxData[{
 RowBox[{
  RowBox[{"numeta", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"i", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "4", ",", "4"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numpath", "=", "2"}], ";"}], "\[IndentingNewLine]", 
