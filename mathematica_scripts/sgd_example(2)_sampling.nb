   3.9188091854499874`*^9, 3.918809210838494*^9}, {3.918809377658452*^9, 
   3.9188094353680687`*^9}, 3.9188094765227656`*^9, {3.919137591510293*^9, 
   3.919137603413001*^9}, {3.9191647800232167`*^9, 3.919164783994727*^9}, {
   3.919183302724581*^9, 3.9191833135534267`*^9}},
