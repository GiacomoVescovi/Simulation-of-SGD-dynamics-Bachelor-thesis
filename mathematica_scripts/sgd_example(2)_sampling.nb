       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", "x", "]"}], ",", "x"}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", " ", "a"}], "]"}], " ", "dW"}]}]}], ";", "  ", 
    RowBox[{"FP", " ", "stazionaria", " ", 
     RowBox[{"associata", " ", ":"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"fpeq", " ", "=", " ", 
  RowBox[{"0", "\[Equal]", 
   RowBox[{
    RowBox[{"a", " ", 
