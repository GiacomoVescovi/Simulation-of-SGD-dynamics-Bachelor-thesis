  3.919403665490044*^9}},ExpressionUUID->"6615adad-ef05-42da-b5f7-\
a399d6e9b547"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "campiono", " ", "i", " ", "minimi", " ", "nella", " ", "zona", " ", 
    "attorno", " ", "al", " ", "punto", " ", "di", " ", "sella"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numpoints", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parts", "=", " ", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"2", ",", "6", ",", "numpoints"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sad", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "numpoints"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", " ", 
      RowBox[{"i", "\[LessEqual]", "numpoints"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"areal", "=", 
        RowBox[{"x", "/.", 
         RowBox[{"Last", "[", " ", 
          RowBox[{"FindMinimum", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"loss", "[", 
               RowBox[{"x", ",", 
                RowBox[{"parts", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"x", ">", "0"}]}], "}"}], ",", 
            RowBox[{"{", "x", "}"}]}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"arealmin", "=", 
        RowBox[{"x", "/.", 
