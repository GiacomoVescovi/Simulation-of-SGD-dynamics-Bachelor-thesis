      RowBox[{
       RowBox[{
        RowBox[{"p", "[", "x", "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], ",", "x"}], "]"}]}], ",", "x"}], 
      "]"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"fpeq", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "x", "]"}], "\[Rule]", "gb"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "'"}], "[", "x", "]"}], "\[Rule]", 
       RowBox[{"D", "[", 
        RowBox[{"gb", ",", "x"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "''"}], "[", "x", "]"}], "\[Rule]", 
       RowBox[{"D", "[", 
        RowBox[{"gb", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "nota", " ", "come", " ", "si", " ", "pu\[OGrave]", " ", "raccogliere", 
