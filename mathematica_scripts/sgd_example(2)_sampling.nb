            RowBox[{"fmod", "[", 
             RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}], 
         ",", "a"}], "]"}], ",", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", " ", "-", 
            RowBox[{"fmod", "[", 
             RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}], 
         ",", "b"}], "]"}]}], "}"}]}], " ", ";"}], "\[IndentingNewLine]", 
