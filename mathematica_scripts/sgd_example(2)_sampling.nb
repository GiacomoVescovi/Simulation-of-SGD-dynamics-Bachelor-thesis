       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"b", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "a"}], " ", "x"}], ")"}]}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}]}]}]}], ")"}]}], "+", 
      RowBox[{"a", "^", "2"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"NOTA", ":", " ", 
     RowBox[{
      RowBox[{
      "puoi", " ", "provare", " ", "ad", " ", "aggiungere", " ", "questo", 
       " ", "termine", " ", 
       RowBox[{"a", "^", "2"}], " ", "come", " ", "\"\<penalit\[AGrave]\>\"", 
       " ", "per", " ", "eliminare", " ", "gli", " ", "infiniti", " ", 
       "minimi", " ", "con", " ", "a"}], ">", "0"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"losssingle", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", " ", "-", 
        RowBox[{"fmod", "[", 
         RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}]}], 
    ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "questa", " ", "\[EGrave]", " ", "solo", " ", "la", " ", "parte", " ", 
      "quadratica"}], ",", " ", 
     RowBox[{"senza", " ", "somma", " ", "o", " ", "normalizzazione"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradloss", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
