  3.919415530837286*^9}},ExpressionUUID->"432b5e0d-3889-40eb-9319-\
606bf7c0238f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"IPERPARAMETRI", " ", "DEL", " ", "SGD"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxite", " ", "=", "30000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eta", " ", "=", "0.0023"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bsize", " ", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "costruisco", " ", "il", " ", "vettore", " ", "dei", " ", "parametri", 
      " ", "che", " ", "ottimizzo"}], ",", " ", 
     RowBox[{
     "tengo", " ", "tutti", " ", "le", " ", "iterazioni", " ", "per", " ", 
      "la", " ", "visualizzazione"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lossvalues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "maxite"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{"per", " ", "visualizzazione"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totlossvalues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"ite", ",", "1", ",", "maxite"}], "}"}]}], "]"}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "sarebbe", " ", "la", " ", "loss", " ", "usata", " ", "nel", " ", "GD"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"arealmin", ",", "brealmin"}], "}"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vprev", "=", 
     RowBox[{"{", 
      RowBox[{"arealmin", ",", "brealmin"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vcurrent", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"arealmin", ",", "brealmin"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"SGD", " ", 
     RowBox[{
     "loop", " ", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
      "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
      "**", "**", "**", "**", "**"}]}], "********)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ite", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
