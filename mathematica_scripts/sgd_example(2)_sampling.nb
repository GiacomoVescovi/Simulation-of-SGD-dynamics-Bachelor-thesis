     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"numpath", "*", "maxtimes"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"calcolo", " ", 
     RowBox[{"l", "'"}], "hessiano"}], ",", " ", 
    RowBox[{
    "lo", " ", "valuto", " ", "su", " ", "tutto", " ", "il", " ", "set", " ", 
     "e", " ", "nel", " ", "punto", " ", "di", " ", "minimo", " ", "nello", 
     " ", "spazio", " ", "dei", " ", "parametri", 
     RowBox[{"(", 
      RowBox[{"che", " ", "conosco"}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessloss", "[", 
     RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", " ", "-", 
               RowBox[{"fmod", "[", 
                RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}],
             ",", "a"}], "]"}], ",", "a"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", " ", "-", 
               RowBox[{"fmod", "[", 
                RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}],
             ",", "a"}], "]"}], ",", "b"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", " ", "-", 
               RowBox[{"fmod", "[", 
                RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}],
             ",", "b"}], "]"}], ",", "a"}], "]"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", " ", "-", 
               RowBox[{"fmod", "[", 
                RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}],
             ",", "b"}], "]"}], ",", "b"}], "]"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"vauluto", " ", 
    RowBox[{"l", "'"}], "hessiano", " ", "nel", " ", "minimo", " ", "reale"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hesslossmin", "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hessloss", "[", 
         RowBox[{
          RowBox[{"data", "[", 
