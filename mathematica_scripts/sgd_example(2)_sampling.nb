Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"loss", " ", "function", " ", "sul", " ", "singolo", " ", "dato"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"losssingle", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", " ", "-", 
        RowBox[{"fmod", "[", 
         RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bsize", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "matrice", " ", "hessiana", " ", "per", " ", "la", " ", "loss", " ", 
     "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hessloss", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", " ", "-", 
                RowBox[{"fmod", "[", 
                 RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", 
              "2"}], ",", "a"}], "]"}], ",", "a"}], "]"}], ",", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", " ", "-", 
                RowBox[{"fmod", "[", 
                 RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", 
              "2"}], ",", "a"}], "]"}], ",", "b"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", " ", "-", 
                RowBox[{"fmod", "[", 
                 RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", 
              "2"}], ",", "b"}], "]"}], ",", "a"}], "]"}], ",", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", " ", "-", 
                RowBox[{"fmod", "[", 
                 RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", 
              "2"}], ",", "b"}], "]"}], ",", "b"}], "]"}]}], "}"}]}], "}"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"gradiente", " ", "della", " ", "loss", " ", "function"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradloss", "[", 
      RowBox[{"x_", ",", "y_", ",", "a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", " ", "-", 
            RowBox[{"fmod", "[", 
             RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}], 
         ",", "a"}], "]"}], ",", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", " ", "-", 
            RowBox[{"fmod", "[", 
             RowBox[{"x", ",", "a", ",", "b"}], "]"}]}], ")"}], "^", "2"}], 
         ",", "b"}], "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gradlosstot", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "ntot"}], ")"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"gradloss", "[", 
            RowBox[{
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"data", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", "x", ",", "y"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "ll"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nn"}], "}"}]}], "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "\[Rule]", "a"}], ",", 
        RowBox[{"y", "\[Rule]", "b"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"covariance", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"bsize", "*", "ntot"}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
