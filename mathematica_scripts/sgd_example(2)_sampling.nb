    RowBox[{
    "quindi", " ", "non", " ", "\[EGrave]", " ", "un", " ", "problema", " ", 
     "cambiarlo"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxite", " ", "=", "120000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"v", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "numpath"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", "numeta", "]"}]}], "}"}]}], "]"}]}], ";"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vitecount", "=", 
     RowBox[{"{", "0", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Per", " ", "ogni", " ", "eta", " ", "simulo", " ", "numpath", " ", 
     "cammini", " ", "con", " ", "maxite", " ", "iterazioni"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"k", "=", "1"}], ",", " ", 
     RowBox[{"k", "\[LessEqual]", " ", 
      RowBox[{"Length", "[", "numeta", "]"}]}], ",", 
     RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<numeta: \>\"", ",", "k"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"IPERPARAMETRI", " ", "DEL", " ", "SGD"}], " ", "*)"}], 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"eta", " ", "=", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{"numeta", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ",", " ", 
        RowBox[{"j", " ", "\[LessEqual]", " ", "numpath"}], ",", 
        RowBox[{"j", "++"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<numpath: \>\"", ",", "j"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vcurrent", "=", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vprev", "=", "vcurrent"}], ";", "\[IndentingNewLine]", 
         RowBox[{"ite", "=", "2"}], ";", "\n", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"areal", "-", 
               RowBox[{"vcurrent", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "\[GreaterEqual]", 
             " ", "0.05"}], " ", "||", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"breal", "-", 
                RowBox[{"vcurrent", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "\[GreaterEqual]", 
              " ", "0.05"}], " ", "&&", 
             RowBox[{"ite", "\[LessEqual]", "120000"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"ite", ",", "10000"}], "]"}], "\[Equal]", "0"}], ",", 
              " ", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<ite: \>\"", ",", "ite"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"vprev", " ", "=", " ", "vcurrent"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"sceglie", " ", "il", " ", "nuovo", " ", "minibatch"}], 
             " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{"xidxs", " ", "=", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", "nn"}], "}"}], ",", "bsize"}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"yidxs", "=", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", "ll"}], "}"}], ",", "bsize"}], "]"}]}], ";",
             " ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{
              "nota", " ", "che", " ", "si", " ", "fa", " ", "cos\[IGrave]", 
               " ", "solo", " ", "per", " ", "il", " ", "modo", " ", "in", 
               " ", "cui", " ", "ho", " ", "costruito", " ", "i", " ", 
               "dati"}], ",", " ", 
              RowBox[{
              "in", " ", "generale", " ", "non", " ", "devi", " ", 
               "scegliere", " ", "x", " ", "e", " ", "y", " ", "in", " ", 
               "maniera", " ", 
               RowBox[{"indipendente", "!"}]}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"xis", " ", "=", 
             RowBox[{"Table", "[", " ", 
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"xidxs", "[", 
                   RowBox[{"[", "bidx", "]"}], "]"}], ",", "1"}], "]"}], 
                "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"bidx", ",", "1", ",", "bsize"}], "}"}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"yis", " ", "=", " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"xidxs", "[", 
                    RowBox[{"[", "bidx", "]"}], "]"}], ",", "2"}], "]"}], 
                 "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"yidxs", "[", 
                  RowBox[{"[", "bidx", "]"}], "]"}], " ", "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"bidx", ",", "1", ",", "bsize"}], "}"}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "calcola", " ", "il", " ", "gradiente", " ", "medio", " ", 
              "della", " ", "loss", " ", "rispetto", " ", "ai", " ", 
              "parametri"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
            RowBox[{"gradlossvector", "=", " ", 
             RowBox[{
              RowBox[{"1", "/", "bsize"}], " ", "\[IndentingNewLine]", " ", 
