        RowBox[{
         RowBox[{"-", "w"}], ",", "w"}], "}"}], "]"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"ite", "=", "2"}], ",", 
