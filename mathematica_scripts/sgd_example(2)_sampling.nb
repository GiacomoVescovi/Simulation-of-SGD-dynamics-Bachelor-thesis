Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"generate", " ", "a", " ", "sample", " ", "from", " ", "ftrue"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nn", "=", "30"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ll", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ntot", "=", 
     RowBox[{"nn", " ", "ll"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "datapoints"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"xi", "-", 
        RowBox[{"Floor", "[", 
         RowBox[{"nn", "/", "2"}], "]"}]}], ",", 
       RowBox[{"{", " ", 
        RowBox[{"xi", ",", "1", ",", "nn"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fi", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"ftrue", "[", 
         RowBox[{"x", "/.", 
          RowBox[{"(", 
           RowBox[{"x", "\[Rule]", 
            RowBox[{"xs", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "xs", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eps", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epss", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "eps"}], ",", "eps"}], "}"}], ",", 
       RowBox[{"ll", "*", 
        RowBox[{"Length", "[", "fi", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"xs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fi", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", 
            RowBox[{"epss", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "j"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"ll", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "fi", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", "**"}], "*", "genero", " ", "dati", " ", "per", " ", 
     RowBox[{"l", "'"}], "errore", " ", "di", " ", 
     RowBox[{"generalizzazione", "**", "**", "**"}]}], "******)"}], "\n", 
   RowBox[{
    RowBox[{"nnp", "=", " ", 
     RowBox[{"Floor", "[", 
      RowBox[{"N", "[", 
       RowBox[{"nn", "/", "5"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"llp", " ", "=", " ", 
     RowBox[{"Floor", "[", 
      RowBox[{"N", "[", 
       RowBox[{"ll", "/", "5"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ntotp", "=", 
     RowBox[{"nnp", " ", "llp"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"number", " ", "of", " ", "datapoints"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xsp", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"xi", "-", 
        RowBox[{"Floor", "[", 
         RowBox[{"nnp", "/", "2"}], "]"}]}], ",", 
       RowBox[{"{", " ", 
        RowBox[{"xi", ",", "1", ",", "nnp"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fip", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"ftrue", "[", 
         RowBox[{"x", "/.", 
          RowBox[{"(", 
           RowBox[{"x", "\[Rule]", 
            RowBox[{"xsp", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "xsp", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epssp", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "eps"}], ",", "eps"}], "}"}], ",", 
       RowBox[{"llp", "*", 
        RowBox[{"Length", "[", "fip", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datap", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"xsp", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fip", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", 
            RowBox[{"epssp", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "j"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"llp", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "fip", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lossp", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "ntotp"}], ")"}], "*", 
      RowBox[{"Sum", "[", " ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"datap", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "[", 
              RowBox[{"[", "j", "]"}], "]"}], "-", 
             RowBox[{"fmod", "[", 
              RowBox[{
               RowBox[{"datap", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "a", ",", "b"}], 
              "]"}]}], ")"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "llp"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nnp"}], "}"}]}], "]"}]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "loss", " ", "function", " ", "per", " ", "il", " ", "validation", " ", 
     "set"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
      "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
     "**"}], "*******)"}]}]}]], "Input",
 CellChangeTimes->{{3.918726200361319*^9, 3.918726200838039*^9}, 
   3.918726240776351*^9, {3.918726477624197*^9, 3.918726545204597*^9}, {
   3.918727689202628*^9, 3.918727760589861*^9}, {3.9187279927769547`*^9, 
   3.9187280273553247`*^9}, {3.918728060203751*^9, 3.9187281270095263`*^9}, {
   3.918728585291074*^9, 3.9187286228288803`*^9}, {3.918728657730597*^9, 
